# Donna v2 — everything runs locally. There is no LLM API key because there is no
# cloud model: inference goes to Ollama on this machine.

# --- Required ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Ollama ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=180

# Keep-alive is finite on purpose: the 9b holds ~6.4 GB of VRAM, so it hands the GPU back
# when Donna is idle. Set CHAT_KEEP_ALIVE=-1 to pin it permanently (faster first message,
# but the GPU stays occupied).
# CHAT_KEEP_ALIVE=30m
# WORKER_KEEP_ALIVE=10m

# Override the model for any single task without touching code, e.g.
# DONNA_MODEL_CLASSIFY_EMAIL=qwen3.5:9b
# DONNA_MODEL_ROUTE=qwen3.5:0.8b

# Ollama itself needs this to keep all three models resident. Set it for the Ollama
# service (a user environment variable on Windows), not just for this process.
# OLLAMA_MAX_LOADED_MODELS=3

# --- Google ---
# CALENDAR_TIMEZONE=Europe/Rome
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json

# --- Storage ---
# DB_PATH=donna.db

# --- Interfaces ---
# Where proactive notifications go. Captured automatically the first time you send /start.
# TELEGRAM_CHAT_ID=
# WEB_HOST=127.0.0.1
# WEB_PORT=8765

# --- Sync and pipeline ---
# SYNC_INTERVAL_MINUTES=5
# GMAIL_SYNC_WINDOW_DAYS=7
# Extraction below this confidence is retried once on the big model.
# EXTRACT_ESCALATE_BELOW=0.6
# Below this, no proposal is created at all.
# PROPOSAL_CONFIDENCE_FLOOR=0.4
# PROPOSAL_EXPIRY_DAYS=7

# --- Logging ---
# LOG_LEVEL=INFO
